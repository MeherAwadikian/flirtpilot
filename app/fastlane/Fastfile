default_platform(:ios)

# Prerequisites (all supplied as GitHub Actions secrets — see .github/workflows/ios.yml):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (contents of the .p8 App Store Connect API key)
# Code signing — choose ONE and provide its secrets:
#   (a) fastlane match (recommended): MATCH_GIT_URL, MATCH_PASSWORD, and a deploy key for that repo
#   (b) manual: import a .p12 cert + .mobileprovision in CI before build (see commented block)
#
# The native iOS project is generated at build time by Capacitor:
#   npm run build && npx cap add ios && npx cap sync ios
# which produces ios/App/App.xcworkspace with scheme "App".

WORKSPACE = "ios/App/App.xcworkspace"
SCHEME    = "App"

platform :ios do
  desc "Build and upload a TestFlight beta"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      in_house: false
    )

    # --- Signing: option (a) fastlane match ---
    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        git_url: ENV["MATCH_GIT_URL"],
        readonly: true,
        api_key: api_key
      )
    end
    # --- Signing: option (b) manual certs ---
    # Import your distribution .p12 and profile in the workflow before this lane, e.g. with
    # apple-actions/import-codesign-certs, then set EXPORT_METHOD/PROFILE below.

    # Auto-increment build number from TestFlight so each upload is unique.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "live.aiology.flirtpilot",
      initial_build_number: 0
    ) rescue 0
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: latest + 1)

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "FlirtPilot.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "build/FlirtPilot.ipa"
    )
  end
end
