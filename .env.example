# ---------------------------------------------------------------------------
# SECRET values — DO NOT put these here or anywhere in git. Copy this file to
# `.env` (gitignored) and fill them locally / in your host's secret store only.
# The service_role key and DB password bypass RLS and grant full DB control.
SUPABASE_SERVICE_ROLE_KEY=      # from dashboard > Settings > API Keys (sb_secret_...)
SUPABASE_DB_PASSWORD=           # set/reset under Settings > Database
OPENROUTER_API_KEY=            # server-side only; never expose to the client
